# Copy to .env and edit. Never commit .env.
# PostgreSQL 18 on this machine listens on port 5433 (PostgreSQL 15 uses 5432).
DB_HOST=localhost
DB_PORT=5433
DB_USER=safety_app
DB_PASSWORD=change_me
DB_NAME=safety_db
TEST_DB_NAME=safety_test
# Superuser credentials, used ONLY by scripts/create_databases.py (remove afterwards if you like)
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=change_me_admin
API_BASE_URL=http://localhost:8000
RANDOM_SEED=20261022
